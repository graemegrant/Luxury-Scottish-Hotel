# ── SANITY ─────────────────────────────────────────────────────────────────
# Create a project at https://sanity.io and paste your project ID below
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Read token — only required for draft previews or server-side writes
# SANITY_API_TOKEN=

# ── SITE ───────────────────────────────────────────────────────────────────
# The public URL for this hotel site (used in metadata, sitemaps, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://craigmorehouse.com

# ── CONTACT FORM (Resend) ──────────────────────────────────────────────────
# https://resend.com — add your API key when wiring up the contact form
# RESEND_API_KEY=

# ── BOOKING ENGINE ─────────────────────────────────────────────────────────
# The URL your "Book Now" buttons redirect to (FreeToBook, Guestline, etc.)
# NEXT_PUBLIC_BOOKING_ENGINE_URL=https://your-booking-engine.com

# ── ANALYTICS ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ── CONTACT FORM ───────────────────────────────────────────────────────────
# Email address that receives contact form submissions
CONTACT_FORM_TO=reservations@craigmorehouse.com
# From address — must be a verified sender in your Resend account
CONTACT_FORM_FROM=noreply@craigmorehouse.com
